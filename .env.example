# Leave DATABASE_URL unset to use a local SQLite file at ./data/prep.db.
# For a hosted database (e.g. Turso free tier):
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Strongly recommended for any public deployment: require a password.
# APP_PASSWORD=choose-a-long-password

# Set to 1 to start with an empty workspace instead of the starter curriculum.
# SKIP_SEED=1
